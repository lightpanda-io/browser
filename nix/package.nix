{
  src,
  lib,
  pkgs,
  stdenv,
  fetchurl,
  zig,
  craneLib,
  version,
  buildInputs ? [ ],
}:
let
  # Generated by nix/update-v8-deps.sh from the defaults in
  # .github/actions/install/action.yml — rerun that script when those change.
  v8Deps = import ./v8-deps.nix;
  v8Archive = v8Deps.archives.${stdenv.hostPlatform.system};

  v8 = fetchurl {
    url = "https://github.com/lightpanda-io/zig-v8-fork/releases/download/${v8Deps.tag}/libc_v8_${v8Deps.version}_${v8Archive.platform}.a";
    hash = v8Archive.hash;
  };

  rustLib = craneLib.buildPackage {
    pname = "lightpanda-ffi";
    inherit version;
    src = src + "/src/rust";
    cargoExtraArgs = "-p lightpanda-ffi";
    doCheck = false;
  };
  rustFfiLib = "${rustLib}/lib/liblightpanda_ffi.a";

  zigDeps =
    pkgs.runCommand "lightpanda-zig-deps"
      {
        nativeBuildInputs = [ zig ];
        outputHash = "sha256-O25mwh9d+nU95cL2T6CMqj735f4rIbNoHumhg9CiGeQ=";
        outputHashMode = "recursive";
      }
      ''
        cp -r --no-preserve=mode ${src} source
        cd source

        export ZIG_GLOBAL_CACHE_DIR="$PWD/zig-cache"
        export ZIG_LOCAL_CACHE_DIR="$ZIG_GLOBAL_CACHE_DIR"

        TERM=dumb zig build --fetch=all

        mkdir -p "$ZIG_GLOBAL_CACHE_DIR/p"
        cp -r "$ZIG_GLOBAL_CACHE_DIR/p" "$out"
      '';

  zigTargetTriple = "${stdenv.hostPlatform.parsed.cpu.name}-${stdenv.hostPlatform.parsed.kernel.name}-${stdenv.hostPlatform.parsed.abi.name}";
in
stdenv.mkDerivation {
  pname = "lightpanda";
  version = "${version}-nix";
  inherit src;

  nativeBuildInputs = buildInputs ++ [
    pkgs.autoPatchelfHook
  ];

  configurePhase = ''
    runHook preConfigure

    export HOME="$TMPDIR/home"
    mkdir -p "$HOME"

    export ZIG_GLOBAL_CACHE_DIR="$TMPDIR/zig-global-cache"
    export ZIG_LOCAL_CACHE_DIR="$ZIG_GLOBAL_CACHE_DIR"
    mkdir -p "$ZIG_GLOBAL_CACHE_DIR"
    cp -r --no-preserve=mode ${zigDeps}/. "$ZIG_GLOBAL_CACHE_DIR/p"

    runHook postConfigure
  '';

  buildPhase = ''
    runHook preBuild

    TERM=dumb zig build \
      -Doptimize=ReleaseFast \
      -Dtarget=${zigTargetTriple} \
      -Dprebuilt_v8_path=${v8} \
      -Dprebuilt_rust_path=${rustFfiLib} \
      -Dversion=${version}

    runHook postBuild
  '';

  installPhase = ''
    runHook preInstall

    mkdir -p $out/bin
    cp zig-out/bin/lightpanda $out/bin/lightpanda

    runHook postInstall
  '';

  meta = {
    description = "Headless browser designed for AI and automation";
    homepage = "https://lightpanda.io";
    license = lib.licenses.agpl3Only;
    mainProgram = "lightpanda";
    platforms = builtins.attrNames v8Deps.archives;
  };
}
